<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="6dp"
    android:paddingTop="1dp"
    android:paddingEnd="6dp"
    android:paddingBottom="1dp">

    <LinearLayout
        android:id="@+id/file_manager_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_file_manager_row"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@id/file_manager_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_file_manager_icon"
            android:contentDescription="@null"
            android:padding="9dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/file_manager_entry_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@id/file_manager_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:id="@id/file_manager_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>

        <TextView
            android:id="@+id/file_manager_size"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone" />

        <TextView
            android:id="@+id/file_manager_modified"
            android:layout_width="128dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@id/file_manager_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
